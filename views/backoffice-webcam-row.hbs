<tr id="webcam-row-{{id}}" class="hover:bg-gray-50/50 transition-colors">
    <td class="px-5 py-3 font-medium text-gray-900">{{name}}</td>
    <td class="px-5 py-3 text-gray-500 max-w-[400px] truncate" title="{{url}}">{{url}}</td>
    <td class="px-5 py-3 text-right whitespace-nowrap">
        <button class="inline-flex items-center gap-1 text-sm text-indigo-600 hover:text-indigo-800 font-medium px-2.5 py-1 rounded-md hover:bg-indigo-50 transition-colors"
                hx-get="/backoffice/webcams/{{id}}/edit"
                hx-target="#form-container"
                hx-swap="innerHTML">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Z"/></svg>
            Edit
        </button>
        <button class="inline-flex items-center gap-1 text-sm text-red-600 hover:text-red-800 font-medium px-2.5 py-1 rounded-md hover:bg-red-50 transition-colors"
                hx-delete="/backoffice/webcams/{{id}}"
                hx-target="#webcam-row-{{id}}"
                hx-swap="delete"
                hx-confirm="Delete &quot;{{name}}&quot;?">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0"/></svg>
            Delete
        </button>
    </td>
</tr>
